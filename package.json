{
  "name": "loopstra",
  "version": "0.0.0-dev",
  "description": "Unattended, Claude Code based SDLC loop. Code owns the loop; agents own bounded phases.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jflavan/loopstra.git"
  },
  "homepage": "https://github.com/jflavan/loopstra#readme",
  "bin": {
    "loopstra": "src/cli.ts"
  },
  "files": [
    "src/",
    "templates/",
    "shipped.json",
    "README.md",
    "tsconfig.json"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun scripts/test.ts",
    "test:serial": "bun test --timeout 30000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "coverage": "bun scripts/coverage.ts",
    "deadcode": "bun scripts/deadcode.ts",
    "check": "bun run typecheck && bun run lint && bun run deadcode && bun run test"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "marked": "^16.4.2",
    "preact": "^10.29.8",
    "yaml": "^2.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "knip": "^6.42.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.2"
  }
}
